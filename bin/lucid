#!/usr/bin/env python3
"""lucid: one shared dream for every Claude agent working on a project.

The dream lives in .lucid/: plan.md (the live plan) and log.jsonl (append-only:
decisions, facts, dead ends, blockers, file claims, plan diffs). Hooks inject it
into every session and subagent, and stream other agents' changes in before each
tool call, so nobody works from a stale plan or a lossy summary.

  lucid [--as ID] init | note KIND TEXT [-e path:line ...] | claim GLOB... [--for TASK]
                  | release [GLOB...] | supersede ID... [--why W] | log [--since ID] | status
                  | wait [--timeout S] | end
                  | learn TEXT [--paths GLOB...] [-e path:line ...] [--source S] | rules [export [--check]]
  lucid hook EVENT     (hook JSON on stdin; wired in hooks/hooks.json via hooks/guard.sh)

Team rules are .claude/rules/*.md, which Claude Code loads itself. lucid adds `forbid:` (regexes added lines must not
match) and `review: true` (checked against the diff before a turn ends), per-rule stats, and proposals in .lucid/proposed/.
"""
import argparse
import difflib
import fcntl  # ponytail: POSIX only; Windows would need msvcrt.locking
import fnmatch
import functools
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from contextlib import contextmanager


def _int_env(name, default):
    try:
        return int(os.environ.get(name, default))
    except ValueError:
        return default


KINDS = ("decision", "fact", "failed", "blocker")
EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")
TTL = _int_env("LUCID_CLAIM_TTL", 1200)  # a claim lapses after 20 min of owner silence
STRAY_ALARM = _int_env("LUCID_STRAY_ALARM", 20)  # one command changing this many unclaimed files raises a blocker
CAP_DIGEST, CAP_DELTA, CAP_CLAIMS, CAP_PLAN = 6000, 2500, 1200, 2500  # ponytail: fixed char budgets, make configurable if they bite
RULES = os.environ.get("LUCID_RULES", "on").strip().lower()  # on | observe (record stats, inject nothing) | off
NAGS, CAP_REVIEW = 2, 1500  # forbid feedback per rule+file per session; rule text per review gate
# A user correcting the agent: a possible team convention. ponytail: a regex; a false hit costs one capped hint line.
CORRECTION = re.compile(r"^\W*(?:no|nope|don'?t|do not|never|stop|instead|actually)\b|\b(?:we (?:always|never|don'?t|do not|"
                        r"prefer)|from now on|going forward|in this (?:repo|codebase|project))\b", re.I)
MARK = re.compile(r"<!-- lucid:rules.*?<!-- /lucid:rules -->\n?", re.S)
# Every session where lucid has nothing to share yet: when to use it, so nobody has to say "use lucid".
HINT = ("[lucid] is installed. Use it on your own when it fits; the user won't name it:\n"
        "- Before two or more agents edit files in parallel: /lucid:swarm (one live plan, decision log and file claims they "
        "all share; plan changes reach running workers).\n"
        "- The plan changes while workers run: /lucid:replan.\n"
        "- The user states a standing convention for this repo (\"we never…\", \"from now on…\"): `lucid learn \"<rule>\" "
        "--paths '<glob>' --source chat`. It becomes a team rule once a PR merges it.\n"
        "One agent on an ordinary task needs none of this.")
# plan sections that must reach every agent whole; the rest (tasks, notes) is trimmed first. Field run: the cut
# landed mid-Constraints ("Never z.from…") while 1,100 chars of task globs above it went through.
PROTECTED = re.compile(r"goal|constraint|rule|never|stop|must", re.I)
PLAN_TEMPLATE = "# Plan\n\n## Goal\n\n## Tasks (one owner per file set)\n- [ ] \n\n## Constraints / non-goals\n"
# a `lucid` invocation at command position: start, after ; & | ( newline ` or $( , optionally behind VAR=x prefixes
LUCID_CMD = re.compile(r"(^|[;&|(\n`]|\$\()(\s*(?:\w+=\S*\s+)*)lucid(?:\s+--as[ =]\S+)?(?=\s|$)")
# Files a Bash command writes. Agents often edit through Bash (seen live: a python heredoc), which would
# otherwise bypass claims and the stop gate. ponytail: a heuristic; it misses writes hidden behind variables
# in other languages and can flag a quoted ">" as a write, which only means one extra "please log" nudge.
BASH_WRITES = [re.compile(rx) for rx in (
    r"(?<![<>&\d])>>?\s*([^\s;&|<>()'\"]+)",                         # > file, >> file (not 2>&1)
    r"\btee\s+(?:-\w+\s+)*([^\s;&|]+)",
    r"\b(?:cp|mv|install)\s+(?:-\w+\s+)*\S+\s+([^\s;&|]+)",          # destination
    r"\b(?:rm|truncate|touch)\s+(?:-\w+\s+)*([^\s;&|]+)",
    r"\bsed\b[^;&|\n]*\s-[A-Za-z]*i\b[^;&|\n]*?\s([^\s;&|'\"]+)\s*(?:$|[;&|\n])",  # sed -i ... file
    r"open\(\s*['\"]([^'\"]+)['\"]\s*,\s*['\"][wax]",
)]


def bash_writes(cmd):
    paths = [m for rx in BASH_WRITES for m in rx.findall(cmd)]
    if re.search(r"\.write(?:_text|_bytes|lines)?\(", cmd):  # scripts writing through variables: any quoted path
        paths += re.findall(r"['\"]([\w./-]+\.\w+)['\"]", cmd)
    return [x for x in paths if x != "/dev/null" and not x.startswith(("&", "$", "-"))]
ROOT = D = ""


# ---------- paths & small io ----------

def setup(start):
    global ROOT, D
    root = os.environ.get("LUCID_ROOT") or find_root(start)
    if os.path.isfile(os.path.join(root, ".git")):  # linked git worktree: share the main checkout's dream
        common = git_common_dir(root)
        if common and os.path.isdir(os.path.join(os.path.dirname(common), ".lucid")):
            root = os.path.dirname(common)
    ROOT = os.path.realpath(root)  # macOS: /tmp is /private/tmp; tools report either
    D = os.path.join(ROOT, ".lucid")


def find_root(start):
    """Nearest dir with .lucid/, stopping at the repo root (which is where `lucid init` puts it)."""
    d = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(d, ".lucid")) or os.path.exists(os.path.join(d, ".git")):
            return d
        if os.path.dirname(d) == d:
            return os.path.abspath(start)
        d = os.path.dirname(d)


def git_common_dir(cwd):
    try:
        out = subprocess.run(["git", "rev-parse", "--git-common-dir"], cwd=cwd,
                             capture_output=True, text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""
    return os.path.join(cwd, out) if out else ""


def p(name):
    return os.path.join(D, name)


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, ValueError):
        return ""


def write(path, text):
    """Atomic: parallel hooks for one agent never see a half-written state file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


@functools.lru_cache(maxsize=None)
def fhash(path):
    try:
        with open(path, "rb") as f:
            return hashlib.sha1(f.read()).hexdigest()[:12]
    except OSError:
        return None


def file_lines(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().split("\n")
    except OSError:
        return None


def win_sha(lines):
    return hashlib.sha1("\n".join(x.rstrip() for x in lines).encode()).hexdigest()[:12]


@functools.lru_cache(maxsize=None)
def anchored(path, n, sha):
    """Do the cited lines (with their context) still exist anywhere in the file? Moving them is fine, editing isn't."""
    lines = file_lines(os.path.join(ROOT, path))
    return lines is not None and any(win_sha(lines[i:i + n]) == sha for i in range(max(len(lines) - n + 1, 1)))


def git_dirty():
    """{path: [XY, mtime_ns]} for what git sees as changed, paths relative to ROOT; None outside a work tree."""
    try:  # porcelain paths are relative to the repo top, so strip the prefix when .lucid/ lives in a subdirectory
        pre = subprocess.run(["git", "rev-parse", "--show-prefix"], cwd=ROOT, capture_output=True, timeout=4)
        out = subprocess.run(["git", "--no-optional-locks", "status", "--porcelain", "-z", "--", "."], cwd=ROOT,
                             capture_output=True, timeout=4)
    except (OSError, subprocess.SubprocessError):
        return None
    if pre.returncode or out.returncode:
        return None
    pre = pre.stdout.decode("utf-8", "replace").strip()
    recs, res, i = out.stdout.decode("utf-8", "replace").split("\0"), {}, 0
    while i < len(recs):
        r, i = recs[i], i + 1
        if len(r) < 4:
            continue
        if "R" in r[:2] or "C" in r[:2]:
            i += 1  # a rename/copy record is followed by its source path
        f = r[3:][len(pre):] if r[3:].startswith(pre) else None
        if f:
            try:
                res[f] = [r[:2], os.stat(os.path.join(ROOT, f)).st_mtime_ns]
            except OSError:
                res[f] = [r[:2], 0]  # deleted
    return res


def rel(path):
    return os.path.relpath(os.path.realpath(path), ROOT)


def same(a, b):
    return os.path.realpath(a) == os.path.realpath(b)


def norm_glob(g):
    """Store claims relative to the project root, whether the agent typed ./x, /abs/x or a subdir-relative x."""
    i = min([g.index(c) for c in "*?[" if c in g] or [len(g)])
    head, tail = g[:i], g[i:]
    sep = "/" if tail and (not head or head.endswith("/")) else ""
    return os.path.relpath(os.path.realpath(os.path.join(os.getcwd(), head)) + sep + tail, ROOT)


def who(inp):
    """Stable id per agent: subagents/teammates by agent_id, the main agent by session."""
    if inp.get("agent_id"):
        return "ag-" + hashlib.sha1(str(inp["agent_id"]).encode()).hexdigest()[:6]
    return "main-" + hashlib.sha1(str(inp.get("session_id", "")).encode()).hexdigest()[:4]


def load_state(me):
    try:
        st = json.loads(read(p(".state/%s.json" % me)) or "{}")
        return st if isinstance(st, dict) else {}
    except ValueError:
        return {}


def save_state(me, st):  # also the agent's heartbeat (mtime) for claim liveness
    write(p(".state/%s.json" % me), json.dumps(st))


def clip(s, n, more="… (truncated)"):
    return s if len(s) <= n else s[:n] + "\n" + more


# ---------- the log ----------

@contextmanager
def locked():
    os.makedirs(D, exist_ok=True)
    with open(p("log.jsonl"), "a+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield f


def put(f, entry):
    f.seek(0)
    e = dict(id=sum(1 for _ in f) + 1, ts=int(time.time()), **entry)  # ponytail: O(n) ids, ~15ms at 10k entries
    f.write(json.dumps(e, ensure_ascii=False) + "\n")  # a+ always appends
    f.flush()
    return e


def append(**entry):
    with locked() as f:
        return put(f, entry)


def log_size():
    try:
        return os.path.getsize(p("log.jsonl"))
    except OSError:
        return 0


def entries(start=0):
    """Well-formed entries from byte offset `start` -> (entries, new_offset). Never raises on a bad log."""
    try:
        with open(p("log.jsonl"), "rb") as f:
            f.seek(start)
            data = f.read()
    except OSError:
        return [], start
    end = data.rfind(b"\n") + 1  # skip a half-written last line; readers don't lock
    out = []
    for line in data[:end].splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if isinstance(e, dict) and isinstance(e.get("id"), int) and isinstance(e.get("kind"), str) and "agent" in e:
            e["agent"], e["text"] = str(e["agent"]), str(e.get("text", ""))
            e["ts"] = e["ts"] if isinstance(e.get("ts"), (int, float)) else 0
            out.append(e)
    return out, start + end


TICK = re.compile(r"^(\s*[-*] )\[[ xX]\]", re.M)


def sync_plan(author):
    """Turn any change to plan.md into a logged diff, whoever made it."""
    if read(p("plan.md")) == read(p(".plan.prev")):
        return
    with locked() as f:
        new, old = read(p("plan.md")), read(p(".plan.prev"))
        if new == old:
            return
        try:  # an agent announced this edit (PreToolUse): credit it, not "user". Field run: 4 of 4 sed ticks were misfiled.
            if author == "user" and time.time() - os.path.getmtime(p(".state/plan-editor")) < 120:
                author = read(p(".state/plan-editor")).strip() or author
            os.remove(p(".state/plan-editor"))
        except OSError:
            pass
        e = {"agent": author, "kind": "plan"}
        if TICK.sub(r"\1[ ]", old) == TICK.sub(r"\1[ ]", new):  # only checkboxes flipped: progress, not a new directive
            ticked = [x for x in new.splitlines() if TICK.match(x) and x not in old.splitlines()]
            e.update(progress=True, text=", ".join(re.sub(r"^\s*[-*] ", "", x).split(":")[0][:50] for x in ticked) or "unticked")
        else:
            lines = lambda t: (t.rstrip("\n") + "\n").splitlines(True) if t else []
            e["text"] = clip("".join(list(difflib.unified_diff(lines(old), lines(new), n=1))[2:]), 3000)
        put(f, e)
        write(p(".plan.prev"), new)


def plan_view(plan, cap=CAP_PLAN):
    """The plan as injected: Goal and Constraints whole, tasks and notes shortened first."""
    if len(plan) <= cap:
        return plan
    plan = re.sub(r"(?m)^(\s*[-*] \[[xX]\] [^:\n]{1,60}?):.+$", r"\1: done", plan)  # a done task's file list is history
    secs = [s.rstrip("\n").split("\n") for s in re.split(r"(?m)^(?=#)", plan) if s.strip()]
    soft = [s for s in secs if not PROTECTED.search(s[0])]
    size = lambda: sum(len(x) + 1 for s in secs for x in s) + len(secs)
    for s in soft:
        if size() > cap:
            s[1:] = [x if len(x) <= 100 else x[:99] + "…" for x in s[1:]]
    cut = False
    while size() > cap - 60 and any(len(s) > 1 for s in soft):
        max((s for s in soft if len(s) > 1), key=lambda s: sum(map(len, s))).pop()
        cut = True
    out = "\n\n".join("\n".join(s).strip("\n") for s in secs)
    return clip(out + ("\n… (trimmed; full plan: .lucid/plan.md)" if cut else ""), cap, "… (full plan: .lucid/plan.md)")


def fold(es):
    """-> (superseded ids, {agent: {glob: task}}, {agent: last activity ts})"""
    dead, claims, last = set(), {}, {}
    for e in es:
        last[e["agent"]] = max(last.get(e["agent"], 0), e["ts"])
        globs = [g for g in e.get("globs") or [] if isinstance(g, str)]
        if e["kind"] == "supersede":
            dead.update(i for i in e.get("ids") or [] if isinstance(i, int))
        elif e["kind"] == "claim":
            claims.setdefault(e["agent"], {}).update({g: str(e.get("task", "")) for g in globs})
        elif e["kind"] == "release":
            if globs:
                for g in globs:
                    claims.get(e["agent"], {}).pop(g, None)
            else:
                claims.pop(e["agent"], None)
    return dead, claims, last


def alive(agent, last):
    try:
        beat = os.path.getmtime(p(".state/%s.json" % agent))
    except OSError:
        beat = 0
    return time.time() - max(last.get(agent, 0), beat) < TTL


def covers(glob, path):
    g = glob.rstrip("/")
    return fnmatch.fnmatch(path, g) or path.startswith(g + "/")


def stale(e):
    hashes, anchors = e.get("hashes"), e.get("anchors")
    if isinstance(anchors, list) and any(isinstance(a, list) and len(a) == 3 and isinstance(a[0], str) and isinstance(a[1], int)
                                         and not anchored(a[0], a[1], str(a[2])) for a in anchors):
        return True
    return isinstance(hashes, dict) and any(fhash(os.path.join(ROOT, f)) != h for f, h in hashes.items())


def fmt(e, short=False):
    if e["kind"] == "plan":
        if e.get("progress"):
            return "#%d progress (%s): %s" % (e["id"], e["agent"], e["text"])
        return "#%d PLAN CHANGED by %s:\n%s" % (e["id"], e["agent"], e["text"].rstrip())
    globs = [g for g in e.get("globs") or [] if isinstance(g, str)]
    if short and e["kind"] == "claim" and len(globs) > 2:  # field run: one claim note ran to 774 chars of globs
        try:
            under = os.path.commonpath([re.split(r"[*?\[]", g)[0].rstrip("/") or "." for g in globs])
        except ValueError:
            under = ""
        task = str(e.get("task") or "")
        return "#%d claim (%s): %d paths%s%s" % (e["id"], e["agent"], len(globs), " under %s/" % under if under not in ("", ".") else "",
                                                 " (%s)" % task if task else "")
    ev = e.get("evidence")
    ev = " [%s]" % ", ".join(map(str, ev)) if isinstance(ev, list) and ev else ""
    who_ = e["agent"] + (", reader" if e.get("reader") else "")
    return "#%d %s (%s): %s%s%s" % (e["id"], e["kind"], who_, e["text"], ev, " ⚠stale" if stale(e) else "")


def digest(me):
    es, off = entries(0)
    dead, claims, last = fold(es)
    how = ("Log what other agents must not rediscover: `lucid note decision|fact|failed|blocker \"...\" -e path:line`. "
           "Claim files before editing: `lucid claim 'glob' --for \"task\"`.")
    if not me.startswith("main-"):  # field run: /code-review agents inherited the hooks and filed unverified "facts"
        how = ("Building part of the plan (your brief said to `lucid claim`)? Claim files before editing, and log what other "
               "agents must not rediscover: `lucid note decision|fact|failed|blocker \"...\" -e path:line`. Reviewing, researching "
               "or answering a question? Read this, but don't write to the log: report to whoever asked you.")
    out = ["[lucid] Shared dream of this project (.lucid/). You are `%s`; your id is added to your `lucid` commands automatically.\n"
           "%s ⚠stale = cited code changed since; re-verify it." % (me, how)]
    plan = read(p("plan.md")).strip()
    if plan and plan != PLAN_TEMPLATE.strip():
        out.append("## Plan (.lucid/plan.md)\n" + plan_view(plan))
    dg = read(p("digest.md"))
    m = re.match(r"<!-- lucid:upto=(\d+) -->\n?", dg)
    upto = int(m.group(1)) if m else 0
    if m:
        out.append("## Consolidated (dream up to #%d)\n%s" % (upto, clip(dg[m.end():].strip(), 2000)))
    act = ["- %s: %s%s" % (o, g, " (%s)" % t if t else "") for o, gs in claims.items() if alive(o, last) for g, t in gs.items()]
    if act:
        out.append("## Active claims\n" + clip("\n".join(act), CAP_CLAIMS, "… more: `lucid status`"))
    cands = [e for e in es if e["kind"] in KINDS and e["id"] > upto and e["id"] not in dead]
    budget, kept = CAP_DIGEST - sum(len(x) for x in out), []
    for e in reversed(cands):  # newest first, format lazily: old entries never get hashed
        if e.get("reader") and stale(e):
            continue  # an unverified outsider note whose code has moved on: noise
        line = fmt(e)
        if len(line) + 1 > budget:
            break
        kept.append(line)
        budget -= len(line) + 1
    if kept:
        older = len(cands) - len(kept)
        out.append("## Log (newest last)%s\n%s" % (
            " (%d older: `lucid log`)" % older if older else "", "\n".join(reversed(kept))))
    if len(out) == 1:
        return "", off  # no plan, log or claims yet (e.g. a project that only uses team rules): inject nothing
    return "\n\n".join(out), off


def delta(me, st):
    """What other agents wrote since `me` last looked. Empty string = nothing new (0 tokens)."""
    if not isinstance(st.get("cursor"), int) or st["cursor"] > log_size():  # first contact, or the log was reset
        ctx, st["cursor"] = digest(me)
    else:
        es, st["cursor"] = entries(st["cursor"])
        news = [e for e in es if e["agent"] != me and e["kind"] != "release"]  # claims are checked live; releases are noise
        ctx = ""
        if news:
            more = "… run `lucid log --since %d`" % (news[0]["id"] - 1)
            ctx = "[lucid] %d update(s) from other agents since you last looked:\n%s" % (
                len(news), clip("\n".join(fmt(e, short=True) for e in news), CAP_DELTA, more))
            if any(e["kind"] == "plan" and not e.get("progress") for e in news):  # e2e: a worker obeyed its stale brief over a plan change
                ctx += ("\n↳ .lucid/plan.md is the user's latest intent and overrides your original brief. If the change "
                        "touches files you own or claimed, apply it now and log a decision; otherwise carry on.")
    save_state(me, st)
    return ctx


# ---------- team rules (.claude/rules/) ----------
# Claude Code loads these files itself (`paths:` = when). lucid reads two extra keys it ignores: `forbid` (regexes the
# lines an agent adds must not match) and `review: true` (checked against the diff at the end of a turn). Nothing here
# blocks a write or runs a command from a repo file.

def _scalar(v):
    v = v.strip()
    m = re.match(r"'((?:[^']|'')*)'|\"((?:[^\"\\]|\\.)*)\"", v)
    if m:  # quoted: YAML's '' and \\ / \" escapes; regexes belong in single quotes
        return m.group(1).replace("''", "'") if m.group(1) is not None else re.sub(r"\\(.)", r"\1", m.group(2))
    v = re.sub(r"\s+#.*$", "", v).strip()
    return {"true": True, "false": False}.get(v.lower(), v)


def _items(s):
    """`a, "b", c/{x,y}` -> list; commas inside quotes or {braces} don't split."""
    out, cur, depth, q = [], "", 0, ""
    for ch in s:
        if q:
            q = "" if ch == q else q
        elif ch in "'\"":
            q = ch
        elif ch in "{}":
            depth += 1 if ch == "{" else -1
        elif ch == "," and depth == 0:
            out.append(cur)
            cur = ""
            continue
        cur += ch
    return [_scalar(x) for x in out + [cur] if x.strip()]


def frontmatter(text):
    """-> (meta, body). ponytail: the YAML subset rule files use (key: scalar, key: [a, b], `- item` lists); swap in
    a real YAML parser if rule files grow nested keys."""
    m = re.match(r"---[ \t]*\n(.*?)\n---[ \t]*(?:\n|$)", text, re.S)
    if not m:
        return {}, text
    meta, key = {}, None
    for line in m.group(1).splitlines():
        item = re.match(r"\s+-\s+(.*)|-\s+(.*)", line)
        kv = re.match(r"([\w-]+):\s*(.*)$", line)
        if item and key:
            if not isinstance(meta.get(key), list):
                meta[key] = []
            meta[key].append(_scalar(item.group(1) or item.group(2)))
        elif kv:
            key, v = kv.group(1), kv.group(2).strip()
            meta[key] = _items(v[1:v.rindex("]")]) if v.startswith("[") and "]" in v else (_scalar(v) if v else [])
    return meta, text[m.end():]


def _glob(pat):
    out, i = "", 0
    while i < len(pat):
        if pat.startswith("**/", i):
            out, i = out + "(?:.*/)?", i + 3
        elif pat.startswith("**", i):
            out, i = out + ".*", i + 2
        elif pat[i] in "*?":
            out, i = out + ("[^/]*" if pat[i] == "*" else "[^/]"), i + 1
        elif pat[i] == "{" and "}" in pat[i:]:
            j = pat.index("}", i)
            out, i = out + "(?:%s)" % "|".join(_glob(x) for x in pat[i + 1:j].split(",")), j + 1
        elif pat[i] == "[" and "]" in pat[i + 1:]:
            j = pat.index("]", i + 1)
            out, i = out + "[" + pat[i + 1:j].replace("!", "^", 1 if pat[i + 1] == "!" else 0) + "]", j + 1
        else:
            out, i = out + re.escape(pat[i]), i + 1
    return out


@functools.lru_cache(maxsize=None)
def glob_rx(pat):
    """Claude Code-style path glob: `**/` spans zero or more dirs, `*` stays inside one, `{a,b}` alternates."""
    return re.compile(_glob(pat.lstrip("./") if pat.startswith("./") else pat) + r"\Z")


def applies(rule, f):
    """No `paths` = everywhere (Claude Code loads it at launch); a bare dir path covers what's under it."""
    return not rule["paths"] or any(glob_rx(g).match(f) or f.startswith(g.rstrip("/") + "/") for g in rule["paths"])


@functools.lru_cache(maxsize=None)
def rules():
    base, out = os.path.join(ROOT, ".claude", "rules"), []
    for dp, dns, fns in os.walk(base):
        dns.sort()
        for fn in sorted(x for x in fns if x.endswith(".md")):
            meta, body = frontmatter(read(os.path.join(dp, fn)))
            listify = lambda v: [str(x) for x in (v if isinstance(v, list) else [v] if v else []) if str(x).strip()]
            r = dict(id=os.path.relpath(os.path.join(dp, fn), base), paths=listify(meta.get("paths")), body=body.strip(),
                     review=meta.get("review") is True, forbid_src=listify(meta.get("forbid")), forbid=[], broken="")
            r["title"] = next((x.strip().lstrip("#").strip()[:80] for x in r["body"].splitlines() if x.strip()), r["id"])
            try:
                r["forbid"] = [re.compile(x) for x in r["forbid_src"]]
            except re.error as ex:  # a bad rule file is skipped and listed by `lucid rules`, never breaks a hook
                r["broken"] = "bad forbid regex: %s" % ex
            out.append(r)
    return out


def stat(ev, rid, f=""):
    """One event per line, per machine. O_APPEND writes this small don't interleave, so no lock."""
    try:
        os.makedirs(p(".state"), exist_ok=True)
        fd = os.open(p(".state/rules.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, (json.dumps({"ts": int(time.time()), "ev": ev, "rule": rid, "file": f}) + "\n").encode())
        finally:
            os.close(fd)
    except OSError:
        pass


def added_lines(tool, ti, target):
    """Lines an edit adds. Lines already there (old_string, or the file on disk for Write) never trip a rule."""
    if tool == "Write":
        pairs = [(ti.get("content"), read(target))]
    elif tool == "MultiEdit":
        pairs = [(e.get("new_string"), e.get("old_string")) for e in ti.get("edits") or [] if isinstance(e, dict)]
    else:
        pairs = [(ti.get("new_string"), ti.get("old_string"))]
    out = []
    for new, old in pairs:
        have = {x.strip() for x in str(old or "").splitlines()}
        out += [x.strip() for x in str(new or "").splitlines() if x.strip() and x.strip() not in have]
    return out


def touch(st, path):
    f = rel(path)
    if not f.startswith(("..", ".lucid/")) and f not in st.setdefault("touched", []):
        st["touched"].append(f)


def check_edit(st, tool, ti, target):
    """Pattern rules on the lines this edit adds -> feedback for the agent ('' if clean or capped)."""
    if tool not in ("Edit", "Write", "MultiEdit") or not target:
        return ""
    f, new, msgs = rel(target), None, []
    if f.startswith(".."):
        return ""
    for r in rules():
        if not applies(r, f):
            continue
        if r["paths"]:
            stat("match", r["id"], f)
        if not r["forbid"]:
            continue
        new = added_lines(tool, ti, target) if new is None else new
        bad = [x for x in new if any(rx.search(x) for rx in r["forbid"])]
        if not bad:
            continue
        stat("forbid", r["id"], f)
        key = r["id"] + "::" + f
        flagged, nags = st.setdefault("flagged", {}), st.setdefault("nags", {})
        flagged[key] = (flagged.get(key, []) + bad)[-10:]
        nags[key] = nags.get(key, 0) + 1
        if nags[key] <= NAGS:
            msgs.append("[lucid] team rule %s (\"%s\"): this edit adds `%s` to %s. Fix it, or say in one line why it's an "
                        "exception." % (r["id"], r["title"], bad[0][:120], f))
    return "\n".join(msgs) if RULES == "on" else ""


def review_gate(st):
    """End of turn: the review rules for files this agent touched, plus pattern hits still in the code -> text or ''."""
    touched = st.get("touched") or []
    rs = [r for r in rules() if r["review"] and any(applies(r, f) for f in touched)]
    still = []
    for key, lines in (st.get("flagged") or {}).items():
        rid, f = key.split("::", 1)
        have = {x.strip() for x in file_lines(os.path.join(ROOT, f)) or []}
        left = [x for x in lines if x in have]
        if left:
            stat("unresolved", rid, f)
            still.append("- %s: %s still has `%s`" % (rid, f, left[0][:120]))
    if not rs and not still:
        return ""
    out, budget = ["lucid: before you finish, check this turn's changes against your team's rules (.claude/rules/)."], CAP_REVIEW
    for r in rs:
        stat("review", r["id"])
        body = clip(r["body"], max(budget, 200), "… (full rule: .claude/rules/%s)" % r["id"])
        budget -= len(body)
        out.append("### %s\n%s" % (r["id"], body))
    if still:
        out.append("Pattern rules these changes still break:\n" + "\n".join(still))
    files = " ".join(sorted(touched)[:12]) + (" …" if len(touched) > 12 else "")
    out.append("Read `git diff -- %s` (git diff skips untracked files: read new files directly). Fix what breaks a rule. "
               "Then end with one line per rule: `✓ <rule>`, or `✗ <rule> path:line <why it's an exception>`. "
               "(Asked once per turn.)" % files)
    return "\n\n".join(out)


def learn_hint(inp, st):
    if RULES != "on" or st.get("learn_hints", 0) >= 3 or not CORRECTION.search(str(inp.get("prompt") or "")):
        return ""
    if not (os.path.isdir(os.path.join(ROOT, ".claude", "rules")) or os.path.isdir(p("proposed"))):
        return ""  # a project that hasn't adopted team rules: lucid stays a swarm tool there
    st["learn_hints"] = st.get("learn_hints", 0) + 1
    return ("[lucid] If that's a standing team convention (not just this task), propose it as a team rule: "
            "`lucid learn \"<rule>\" --paths '<glob>' -e path:line --source chat`. Teammates get it once a PR merges it.")


def export_block(rs):
    groups = {}
    for r in rs:
        if not r["broken"]:
            groups.setdefault(", ".join("`%s`" % g for g in r["paths"]) or "Everywhere", []).append(r)
    out = ["<!-- lucid:rules: generated by `lucid rules export` from .claude/rules/. Edit those files, not this block. -->",
           "## Team rules", ""]
    for head in sorted(groups, key=lambda h: (h != "Everywhere", h)):
        out += ["### " + head, ""]
        for r in groups[head]:
            body = re.sub(r"(?m)^(#+) ", lambda m: "#" * min(len(m.group(1)) + 3, 6) + " ", r["body"])
            out += [body if body.startswith("#") else "#### %s\n%s" % (r["title"], body), ""]
            if r["forbid_src"]:
                out += ["Never in new code: " + ", ".join("`%s`" % x for x in r["forbid_src"]), ""]
    return "\n".join(out + ["<!-- /lucid:rules -->"]) + "\n"


# ---------- hooks ----------

def emit(event, ctx, **extra):
    out = dict(hookEventName=event, **extra)
    if ctx:
        out["additionalContext"] = ctx
    if ctx or extra:
        print(json.dumps({"hookSpecificOutput": out}))
    return 0


def live_claims(es):
    """{agent: {glob: task}} for agents whose claims still hold."""
    _, claims, last = fold(es)
    return {o: gs for o, gs in claims.items() if gs and alive(o, last)}


def claim_conflict(me, target, live):
    if same(target, p("log.jsonl")):
        return "lucid: log.jsonl is append-only; use `lucid note|supersede`."
    path = rel(target)
    for owner, gs in live.items():
        if owner != me:
            for g, task in gs.items():
                if covers(g, path):
                    return ("lucid: `%s` is claimed by `%s` (%s%s). Work on something else, or coordinate: "
                            "`lucid note blocker \"...\"` / SendMessage." % (path, owner, g, ": " + task if task else ""))
    return None


def stray_check(me):
    """After a Bash call in a swarm: files it changed that no live claim covers -> (message, alarm) or None.
    Field run: `oxfmt` with an empty file list rewrote 675 files inside a claimed swarm, and only a human noticed."""
    snap = p(".state/%s.dirty.json" % me)
    try:
        with open(snap, encoding="utf-8") as f:
            before = json.load(f)
        os.remove(snap)
    except (OSError, ValueError):
        return None
    now = git_dirty()
    if not isinstance(before, dict) or now is None:
        return None
    # ponytail: a file another agent writes during this call is blamed on this one (claims filter most of those), and
    # re-touching an already-dirty file without moving its mtime goes unseen. Per-agent write tracing would fix both.
    changed = [f for f, (xy, mt) in now.items() if not f.startswith(".lucid/") and (
        f not in before or (xy != "??" and isinstance(before[f], list) and before[f][1:] != [mt]))]
    live = live_claims(entries(0)[0])
    stray = sorted(f for f in changed if not any(covers(g, f) for gs in live.values() for g in gs))
    if not stray:
        return None
    names = ", ".join(stray[:5]) + (" and %d more" % (len(stray) - 5) if len(stray) > 5 else "")
    if len(stray) < STRAY_ALARM:
        return ("lucid: that command changed %d file(s) outside your claim: %s. If they're yours to change, `lucid claim` "
                "them; otherwise revert them." % (len(stray), names), False) if live.get(me) else None
    clean = [f for f in stray if f not in before and now[f][0][0] == " "]  # clean before, now changed in the worktree only
    undo = ""
    if clean:  # restoring these from the index loses nothing: they had no uncommitted edits before this command
        lst = p(".state/stray-%d.txt" % int(time.time() * 1000))
        write(lst, "".join(":(literal)%s\n" % f for f in clean))  # literal: Next.js paths like [id]/ are globs otherwise
        undo = (" Undo the %d that were clean before it, from the project root: `git restore --pathspec-from-file=%s`."
                % (len(clean), os.path.relpath(lst, ROOT)))
    e = append(agent=me, kind="blocker", text=(
        "lucid guard: one Bash command by %s changed %d files outside every claim (%s).%s If it was meant (codegen, a "
        "planned format), log a decision; otherwise stop and undo it." % (me, len(stray), names, undo)))
    return "#%d %s" % (e["id"], e["text"]), True


def hook(event):
    try:
        inp = json.load(sys.stdin)
    except ValueError:
        inp = {}
    inp = inp if isinstance(inp, dict) else {}
    setup(inp.get("cwd") or os.getcwd())
    if not os.path.isdir(D):  # not opted in: guard.sh lets only SessionStart through, to say when lucid helps
        return emit(event, HINT) if event == "SessionStart" else 0
    if os.environ.get("LUCID_DEBUG"):
        with open(p(".debug.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(dict(lucid_event=event, **inp)) + "\n")
    # `lucid end`: the swarm is over, so its hooks go quiet (field run: 2.5 h of solo review rounds still got notes).
    # Team rules are not part of a swarm and keep working.
    ended = os.path.exists(p("ended"))
    team = RULES in ("on", "observe")
    me = who(inp)
    tool, ti = inp.get("tool_name", ""), inp.get("tool_input")
    ti = ti if isinstance(ti, dict) else {}
    target = str(ti.get("file_path") or ti.get("notebook_path") or "")
    cwd = str(inp.get("cwd") or ROOT)
    writes = bash_writes(str(ti.get("command", ""))) if tool == "Bash" else []
    plan = p("plan.md")
    edits_plan = bool(target and same(target, plan)) or any(same(os.path.join(cwd, os.path.expanduser(w)), plan) for w in writes)

    if event == "PostToolUse":
        if ended:
            return 0
        ctx = ""
        if edits_plan:
            sync_plan(me)
            if len(read(plan)) > CAP_PLAN:
                ctx = ("lucid: plan.md is %d chars, so agents get a trimmed view (tasks shortened first, Goal and Constraints "
                       "whole). `lucid status` shows what they see." % len(read(plan)))
        if tool == "Bash":
            msg, alarm = stray_check(me) or ("", False)
            if alarm:
                sys.stderr.write(msg + "\n")
                return 2
            ctx = "\n".join(x for x in (ctx, msg) if x)
        return emit(event, ctx)
    if not ended:
        sync_plan("user")  # plan edited outside Claude's tools (editor, git checkout)
    st = load_state(me)

    if event in ("SessionStart", "SubagentStart"):
        if ended:
            return emit(event, "[lucid] %s `lucid status` shows its plan and log; `lucid init` starts a new swarm."
                        % read(p("ended")).strip()) if event == "SessionStart" else 0
        ctx, st["cursor"] = digest(me)
        if event == "SubagentStart":
            st["parent"] = who({"session_id": inp.get("session_id", "")})  # the lead that spawned it (Stop nudge, wait)
            st.pop("stopped", None)
        save_state(me, st)
        return emit(event, ctx or (HINT if event == "SessionStart" else ""))  # nothing shared yet: say when lucid helps
    if event == "UserPromptSubmit":
        ctx = "" if ended else delta(me, st)
        busy = [] if ended else sorted(o for o in live_claims(entries(0)[0]) if o != me)
        ticks = [] if ended else re.findall(r"(?m)^\s*[-*] \[([ xX])\]", read(plan))
        if busy:  # e2e: leads relayed chat-only plan changes by message and skipped plan.md (1 of 3 recorded it)
            ctx = (ctx + "\n" if ctx else "") + (
                "[lucid] %s still working. If this message changes the plan, edit .lucid/plan.md first (or /lucid:replan): "
                "they get the diff before their next tool call, and it survives /compact." % ", ".join(busy))
        elif ticks and all(t in "xX" for t in ticks) and not inp.get("agent_id") and not st.get("end_hinted"):
            st["end_hinted"] = True
            save_state(me, st)
            ctx = (ctx + "\n" if ctx else "") + (
                "[lucid] Every plan task is done and no other agent is working. If the swarm is over, `lucid end` stops "
                "lucid's hooks here (plan and log stay).")
        hint = learn_hint(inp, st) if team else ""
        if hint:
            save_state(me, st)
        return emit(event, "\n".join(x for x in (ctx, hint) if x))
    if event == "PreToolUse":
        why, extra, note = None, {}, ""
        if not ended and (tool == "Bash" or (tool in EDIT_TOOLS and target)):
            live = live_claims(entries(0)[0])
            if tool == "Bash":
                # Stamp the caller's real id on every `lucid` call (replacing a wrong --as), so agents never
                # manage ids. No permissionDecision: normal permission rules still apply to the rewritten command.
                # ponytail: a "; lucid" inside quoted text gets stamped too; cosmetic
                cmd = str(ti.get("command", ""))
                fixed = LUCID_CMD.sub(lambda m: m.group(1) + m.group(2) + "lucid --as " + me, cmd)
                if fixed != cmd:
                    extra["updatedInput"] = dict(ti, command=fixed)
                for w in writes:
                    why = claim_conflict(me, os.path.join(cwd, os.path.expanduser(w)), live)
                    if why:
                        break
                st["edited"] = st.get("edited") or (bool(writes) and not why)
                snap = p(".state/%s.dirty.json" % me)
                dirty = git_dirty() if live and not why else None  # ~100 ms at 12k files; only while a swarm holds claims
                if dirty is not None:
                    write(snap, json.dumps(dirty))
                elif os.path.exists(snap):
                    os.remove(snap)
            else:
                why = claim_conflict(me, target, live)
                st["edited"] = st.get("edited") or not why
            if edits_plan and not why:  # so a racing hook credits this agent, not "user"
                write(p(".state/plan-editor"), me)
        wrote = team and not why and bool(writes or (tool in EDIT_TOOLS and target))
        if wrote:  # team rules: remember what this turn touched (review gate), check what this edit adds
            for f in writes:
                touch(st, os.path.join(cwd, os.path.expanduser(f)))
            if tool in EDIT_TOOLS and target:
                touch(st, target)
            note = check_edit(st, tool, ti, target)
        ctx = "" if ended else delta(me, st)  # delta saves state
        if ended and wrote:
            save_state(me, st)
        ctx = "\n".join(x for x in (ctx, note) if x)
        if why:
            return emit(event, ctx, permissionDecision="deny", permissionDecisionReason=why)
        return emit(event, ctx, **extra)
    if event in ("SubagentStop", "TaskCompleted") and inp.get("agent_id"):
        msgs = []
        if team and not st.get("reviewed"):
            gate = review_gate(st)
            if gate:
                st["reviewed"] = True  # once per worker
                msgs += [gate] if RULES == "on" else []
        mine = [] if ended else [e for e in entries(0)[0] if e["agent"] == me]
        logged = any(e["kind"] in KINDS + ("plan",) for e in mine)  # changing the plan counts as reporting
        if not ended and st.get("edited") and not st.get("gated") and not logged:
            st["gated"] = True
            msgs.append("lucid: you edited files but logged nothing for the other agents. Before finishing, record decisions "
                        "(+why), dead ends and non-obvious facts: `lucid note decision \"...\" -e path:line`. "
                        "Then finish. (Asked once.)")
        if msgs:
            save_state(me, st)
            sys.stderr.write("\n\n".join(msgs) + "\n")
            return 2
        if event == "SubagentStop" and fold(mine)[1].get(me):
            append(agent=me, kind="release", globs=[], text="all (agent stopped)")
        if event == "SubagentStop":
            st["stopped"] = True  # lets the lead's `lucid wait` return once every worker is done
        save_state(me, st)
    if event == "Stop" and not inp.get("agent_id"):
        msgs = []
        if not inp.get("stop_hook_active"):
            gate = review_gate(st) if team else ""
            msgs += [gate] if gate and RULES == "on" else []
            # Field run: a worker's blocker sat 19 min because the lead had gone idle. A background `lucid wait` wakes it.
            workers = [] if ended else sorted(o for o in live_claims(entries(0)[0]) if o != me and load_state(o).get("parent") == me)
            try:
                waiting = time.time() - os.path.getmtime(p(".state/%s.wait" % me)) < 15
            except OSError:
                waiting = False
            if workers and not waiting and not set(workers) <= set(st.get("nudged") or []):
                st["nudged"] = sorted(set(workers) | set(st.get("nudged") or []))
                msgs.append("lucid: %s still working. Before ending your turn, run `lucid wait` with run_in_background: it "
                            "returns (and wakes you) when a worker logs a blocker or a stray-write alarm." % ", ".join(workers))
        if msgs or st.get("touched") or st.get("flagged"):
            st["touched"], st["flagged"] = [], {}  # the turn is over, or its one review round starts now
            save_state(me, st)
        if msgs:
            sys.stderr.write("\n\n".join(msgs) + "\n")
            return 2
    # A session between turns isn't editing: release its claims. Bench: an ended session's claim blocked the next
    # session for the whole TTL; live: split-pane teammates (separate sessions) sat idle holding claims.
    if not ended and event in ("Stop", "SessionEnd") and not inp.get("agent_id"):
        if fold([e for e in entries(0)[0] if e["agent"] == me])[1].get(me):
            append(agent=me, kind="release", globs=[], text="all (%s)" % ("turn ended" if event == "Stop" else "session ended"))
    return 0


# ---------- cli ----------

def cli(argv):
    ap = argparse.ArgumentParser(prog="lucid", description="Shared dream for Claude agents: live plan, decision log, file claims.")
    ap.add_argument("--as", dest="me", default=os.environ.get("LUCID_AGENT", "human"), help="agent id (hooks fill it in for agents)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init", help="create .lucid/ in this project")
    n = sub.add_parser("note", help="log a decision, fact, dead end (failed) or blocker")
    n.add_argument("kind", choices=KINDS)
    n.add_argument("text")
    n.add_argument("-e", "--evidence", nargs="+", default=[], help="path[:line[-line]] or free text")
    c = sub.add_parser("claim", help="claim files (globs) before editing them")
    c.add_argument("globs", nargs="+")
    c.add_argument("--for", dest="task", default="")
    sub.add_parser("release", help="drop your claims (all, or the given globs)").add_argument("globs", nargs="*")
    s = sub.add_parser("supersede", help="retire wrong or outdated entries")
    s.add_argument("ids", nargs="+", type=int)
    s.add_argument("--why", default="")
    sub.add_parser("log", help="print entries").add_argument("--since", type=int, default=0)
    sub.add_parser("status", help="print the digest agents get")
    sub.add_parser("wait", help="block until another agent logs a blocker or dead end (run it in the background)"
                   ).add_argument("--timeout", type=int, default=1800)
    sub.add_parser("end", help="end the swarm: hooks go quiet, plan and log stay")
    lr = sub.add_parser("learn", help="propose a team rule (.lucid/proposed/; a PR moves it into .claude/rules/)")
    lr.add_argument("text")
    lr.add_argument("--paths", nargs="+", default=[], help="globs the rule applies to (default: everywhere)")
    lr.add_argument("-e", "--evidence", nargs="+", default=[], help="path[:line] where it shows, or a PR link")
    lr.add_argument("--source", default="chat", help="chat | pr#123 | dream | review")
    ru = sub.add_parser("rules", help="team rules with this machine's stats; `export` writes the AGENTS.md block")
    ru.add_argument("action", nargs="?", choices=["export"])
    ru.add_argument("--check", action="store_true", help="with export: exit 1 if AGENTS.md is out of date (for CI)")
    a = ap.parse_args(argv)
    me = re.sub(r"[^\w.-]", "_", a.me) or "human"
    setup(os.getcwd())

    if a.cmd == "rules":
        return rules_cli(a)
    if a.cmd == "init":
        if os.path.exists(p("ended")):  # a new swarm: shelve the finished one so its log doesn't leak into the next feature
            arch = p("archive/" + time.strftime("%Y-%m-%d-%H%M%S"))
            os.makedirs(arch, exist_ok=True)
            for n in ("plan.md", "log.jsonl", "digest.md", "ended"):
                if os.path.exists(p(n)):
                    os.replace(p(n), os.path.join(arch, n))
            if os.path.exists(p(".plan.prev")):
                os.remove(p(".plan.prev"))
            print("lucid: archived the ended swarm to %s" % os.path.relpath(arch, ROOT))
        ensure()
        if not os.path.exists(p("plan.md")):
            write(p("plan.md"), PLAN_TEMPLATE)
        if not os.path.exists(p(".plan.prev")):
            write(p(".plan.prev"), read(p("plan.md")))
        return print("lucid: dream ready at %s. Write the plan in .lucid/plan.md" % D)
    if not os.path.isdir(D):
        if a.cmd != "learn":
            sys.exit("lucid: no .lucid/ found here; run `lucid init` first")
        ensure()  # proposing the first team rule opts the repo in
    sync_plan("user")

    if a.cmd == "note":
        ev, hashes, anchors = evidence(a.evidence)
        extra = {"anchors": anchors} if anchors else {}
        if me.startswith("ag-") and not load_state(me).get("edited") and not any(
                e["agent"] == me and e["kind"] == "claim" for e in entries(0)[0]):
            extra["reader"] = True  # never claimed or edited: a reviewer or researcher, not a swarm worker
        e = append(agent=me, kind=a.kind, text=a.text, evidence=ev, hashes=hashes, **extra)
        print("#%d logged" % e["id"])
        refs = sorted({int(n) for n in re.findall(r"#(\d+)\b", a.text) if int(n) < e["id"]})
        if refs:  # field run: #54 corrected #47, nobody retired #47, and both kept reading as facts
            print("If this replaces %s: `lucid supersede %s --why \"...\"`" % (", ".join("#%d" % n for n in refs), " ".join(map(str, refs))))
    elif a.cmd == "claim":
        globs = [norm_glob(g) for g in a.globs]
        es, _ = entries(0)
        _, claims, last = fold(es)
        for owner, gs in claims.items():
            if owner != me and alive(owner, last):
                for g in gs:
                    for mine in globs:
                        if covers(g, mine.rstrip("/*")) or covers(mine, g.rstrip("/*")):
                            sys.exit("lucid: %s overlaps `%s`'s claim %s. Pick other work or coordinate." % (mine, owner, g))
        e = append(agent=me, kind="claim", globs=globs, task=a.task,
                   text=", ".join(globs) + (": " + a.task if a.task else ""))
        print("#%d claimed" % e["id"])
    elif a.cmd == "release":
        globs = [norm_glob(g) for g in a.globs]
        print("#%d released" % append(agent=me, kind="release", globs=globs, text=", ".join(globs) or "all")["id"])
    elif a.cmd == "supersede":
        text = " ".join("#%d" % i for i in a.ids) + (": " + a.why if a.why else "")
        print("#%d superseded %s" % (append(agent=me, kind="supersede", ids=a.ids, text=text)["id"], text))
    elif a.cmd == "log":
        es, _ = entries(0)
        dead = fold(es)[0]
        for e in es:
            if e["id"] > a.since:
                print(fmt(e) + (" (superseded)" if e["id"] in dead else ""))
        print("last id: %d" % (es[-1]["id"] if es else 0))
    elif a.cmd == "status":
        print(digest(me)[0])
    elif a.cmd == "wait":
        # The lead runs this in the background: Claude Code wakes it when the command exits.
        off, start = entries(0)[1], time.time()
        busy = start
        while time.time() - start < a.timeout:
            write(p(".state/%s.wait" % me), "")  # heartbeat: the Stop nudge stays quiet while someone listens
            off = 0 if off > log_size() else off  # log reset
            es, off = entries(off)
            hits = [e for e in es if e["agent"] != me and e["kind"] in ("blocker", "failed")]
            if hits:
                print("\n".join(map(fmt, hits)))
                return print("lucid: act on this, then run `lucid wait` in the background again.")
            try:
                others = [x for x in os.scandir(p(".state")) if x.name.endswith(".json")
                          and not x.name.endswith(".dirty.json") and x.name != me + ".json"]
            except OSError:
                others = []
            # Bench: `claude -p` stays up while this runs, so idling 5 min after the last worker stopped cost 10 min.
            mine = [s for s in (load_state(x.name[:-5]) for x in others if x.name.startswith("ag-")) if s.get("parent") == me]
            if mine and all(s.get("stopped") for s in mine):
                return print("lucid: all your workers have stopped; nothing left to wait for.")
            if any(time.time() - x.stat().st_mtime < 300 for x in others):
                busy = time.time()
            elif time.time() - busy > 300:
                return print("lucid: no other agent has been active for 5 min; stopped waiting.")
            time.sleep(2)
        print("lucid: no blockers in %d min. Run `lucid wait` again to keep listening." % (a.timeout // 60))
    elif a.cmd == "end":
        m = re.search(r"(?m)^## Goal[^\n]*\n+([^\n#][^\n]*)", read(p("plan.md")))
        goal = m.group(1).strip() if m else "this project"
        text = 'The swarm for "%s" ended %s.' % (goal[:80] + ("…" if len(goal) > 80 else ""), time.strftime("%Y-%m-%d"))
        append(agent=me, kind="end", text=text)
        write(p("ended"), text + "\n")
        print("lucid: ended. Hooks stay quiet here now (team rules still apply); the plan and log are kept. `lucid init` "
              "archives them and starts a new swarm; `rm .lucid/ended` resumes this one.\nNext: run /lucid:dream to "
              "consolidate this swarm's log and propose its lasting lessons as team rules.")
    elif a.cmd == "learn":
        globs = [norm_glob(g) for g in a.paths]
        text = a.text.strip()
        key = lambda s: re.sub(r"\W+", " ", s).strip().lower()
        known = [os.path.join(d, f) for d in (p("proposed"), os.path.join(ROOT, ".claude", "rules"))
                 for f in (os.listdir(d) if os.path.isdir(d) else []) if f.endswith(".md")]
        dup = next((k for k in known if key(text) in key(frontmatter(read(k))[1])), None)
        if dup:
            return print("lucid: already there: %s" % os.path.relpath(dup, ROOT))
        slug = "-".join(re.findall(r"[a-z0-9]+", text.lower())[:6])[:48].strip("-") or "rule"
        path, k = p("proposed/%s.md" % slug), 2
        while os.path.exists(path):
            path, k = p("proposed/%s-%d.md" % (slug, k)), k + 1
        meta = (["paths: [%s]" % ", ".join(json.dumps(g) for g in globs)] if globs else []) + ["source: %s" % a.source]
        ev = evidence(a.evidence)[0]
        meta += (["evidence: [%s]" % ", ".join(json.dumps(x) for x in ev)] if ev else []) + ["proposed: " + time.strftime("%Y-%m-%d")]
        write(path, "---\n%s\n---\n%s\n" % ("\n".join(meta), text))
        print("lucid: proposed %s. It does nothing until a PR moves it into .claude/rules/ (/lucid:learn promote)."
              % os.path.relpath(path, ROOT))


def ensure():
    os.makedirs(p(".state"), exist_ok=True)
    write(p(".gitignore"), ".state/\n.plan.prev\n.debug.jsonl\n*.tmp\n")
    write(p(".gitattributes"), "log.jsonl merge=union\n")  # two people appending never conflicts
    open(p("log.jsonl"), "a").close()


def evidence(items):
    """`path[:line[-line]]` or free text -> (normalized evidence, whole-file hashes, line anchors)."""
    ev, hashes, anchors = [], {}, []
    for x in items:
        m = re.match(r"(.*?)(?::(\d+)(?:-(\d+))?)?$", x)
        path = m.group(1)
        if not os.path.isfile(path):
            ev.append(x)
            continue
        r, lines, lo = rel(path), file_lines(os.path.realpath(path)), int(m.group(2) or 0)
        ev.append(r + x[len(path):])
        if lo and lines and lo <= len(lines):  # anchor the cited lines +-2, so an edit elsewhere in the file isn't "stale"
            win = lines[max(lo - 3, 0):min(max(int(m.group(3) or lo), lo) + 2, len(lines))]
            anchors.append([r, len(win), win_sha(win)])
        else:
            hashes[r] = fhash(os.path.realpath(path))
    return ev, hashes, anchors


def rules_cli(a):
    rs = rules()
    if a.action == "export":
        target = os.path.join(ROOT, "AGENTS.md")
        old = read(target)
        if not rs and not MARK.search(old):
            return print("lucid: no team rules in .claude/rules/ yet; nothing to export.")
        block = export_block(rs)
        m = MARK.search(old)
        new = old[:m.start()] + block + old[m.end():] if m else (old.rstrip("\n") + "\n\n" if old.strip() else "") + block
        if a.check:
            if new != old:
                sys.exit("lucid: AGENTS.md's team-rules block is out of date with .claude/rules/; run `lucid rules export`.")
            return print("lucid: AGENTS.md is up to date with .claude/rules/.")
        if new != old:
            write(target, new)
        print("lucid: AGENTS.md has %d team rules for Codex, Copilot, Cursor and review bots that read it." % len(rs))
        if not any(os.path.exists(os.path.join(ROOT, x)) for x in ("CLAUDE.md", ".claude/CLAUDE.md", "CLAUDE.local.md")):
            print("Note: with no CLAUDE.md, Claude Code reads AGENTS.md too and sees these rules twice. A CLAUDE.md "
                  "(even one line) makes it use CLAUDE.md and .claude/rules/ and leave AGENTS.md to other tools.")
        return
    agg = {}
    for line in read(p(".state/rules.jsonl")).splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if isinstance(e, dict):
            s = agg.setdefault(str(e.get("rule")), {})
            s[str(e.get("ev"))] = s.get(str(e.get("ev")), 0) + 1
            s["last"] = max(s.get("last", 0), e.get("ts") if isinstance(e.get("ts"), int) else 0)
    print("Team rules in .claude/rules/: %d · LUCID_RULES=%s · stats from this machine" % (len(rs), RULES))
    for r in rs:
        s = agg.get(r["id"], {})
        keys = ", ".join(x for x in ("forbid" if r["forbid_src"] else "", "review" if r["review"] else "") if x)
        nums = ", ".join("%s %d" % (k, s[k]) for k in ("match", "forbid", "unresolved", "review") if s.get(k))
        print("- %s%s: %s (%s)%s%s" % (r["id"], " [%s]" % keys if keys else "", r["title"],
                                       ", ".join(r["paths"]) or "everywhere", " · " + nums if nums else "",
                                       " · last %s" % time.strftime("%Y-%m-%d", time.localtime(s["last"])) if s.get("last") else ""))
    idle = [r["id"] for r in rs if r["paths"] and not agg.get(r["id"], {}).get("match")]
    if idle and agg:
        print("Never matched an edit here: %s. Prune them or fix their paths." % ", ".join(idle))
    for r in rs:
        if r["broken"]:
            print("Skipped %s: %s" % (r["id"], r["broken"]))
    prop = sorted(f for f in (os.listdir(p("proposed")) if os.path.isdir(p("proposed")) else []) if f.endswith(".md"))
    if prop:
        print("Proposed, not active (%d): %s. Review them with /lucid:learn promote." % (len(prop), ", ".join(prop)))


if __name__ == "__main__":
    if sys.argv[1:2] == ["hook"]:
        try:
            sys.exit(hook(sys.argv[2] if len(sys.argv) > 2 else ""))
        except Exception as ex:  # a broken hook must never block the agent
            sys.stderr.write("lucid hook error: %r\n" % ex)
            sys.exit(1)
    cli(sys.argv[1:])
